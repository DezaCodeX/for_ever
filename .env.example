# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: The base API URL for your Supabase backend (e.g., https://yourproject.supabase.co)
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# SUPABASE_ANON_KEY: The public anonymous API key for client-side queries
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY

# MONGODB_URI: The connection string for MongoDB Atlas NoSQL cluster
MONGODB_URI=mongodb+srv://mddiaryoflove_db_user:Mohan2212@cluster0.3z2knlx.mongodb.net/?appName=Cluster0

